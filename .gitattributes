# Keep LF line endings for files executed or read inside Linux containers
*.sh        text eol=lf
Dockerfile  text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
*.env*      text eol=lf

# Committed raw dump parts are gzip binary: never normalize line endings
source/data/raw/*.gz.part-*  binary
source/data/raw/SHA256SUMS   text eol=lf
