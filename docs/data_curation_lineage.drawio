          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gold-mongo" edge="1" parent="1" source="gold" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="mongo" value="replace-upsert by _id · purge stale _run_id · build indexes">
