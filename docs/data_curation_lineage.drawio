          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-silver-quarantine" edge="1" parent="1" source="silver-group" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" target="quarantine" value="reject_reason-tagged rows (rules per entity above)">
