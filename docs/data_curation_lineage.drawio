<mxfile>
  <diagram id="dataCurationLineage01" name="Page-1">
    <mxGraphModel dx="1012" dy="453" grid="1" gridSize="10" guides="1" tooltips="0" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2750" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="Data Cleaning — Raw to Gold" vertex="1">
          <mxGeometry height="30" width="1200" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="raw" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;align=left;verticalAlign=top;spacingLeft=8;spacingTop=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;PostgreSQL — raw schema&lt;/b&gt;&lt;br&gt;flight_seat_reservations &lt;i&gt;(1 row/seat/flight + unseated bookings)&lt;/i&gt;&lt;br&gt;airport_sites &lt;i&gt;(1 row/airport)&lt;/i&gt;&lt;br&gt;aircraft_seat_layouts &lt;i&gt;(1 row/seat/aircraft model)&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="90" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="bronze" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;Bronze — lake.bronze.*&lt;/b&gt;&lt;br&gt;flight_seat_reservations&lt;br&gt;airport_sites&lt;br&gt;aircraft_seat_layouts&lt;br&gt;&lt;br&gt;&lt;i&gt;+ _ingest_ts, _batch_id, _source_now&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="80" y="220" as="geometry" />
        </mxCell>
        <mxCell id="silver-group" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=none;fontStyle=2;" value="Silver — lake.silver.* (split → dedupe → validate → PK merge)" vertex="1">
          <mxGeometry height="420" width="1180" x="740" y="90" as="geometry" />
        </mxCell>
        <mxCell id="s-airports" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;airports&lt;/b&gt;&lt;br&gt;src: airport_sites&lt;br&gt;key: airport_code&lt;br&gt;reject: conflicting attrs" vertex="1">
          <mxGeometry height="150" width="260" x="770" y="150" as="geometry" />
        </mxCell>
        <mxCell id="s-aircrafts" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;aircrafts&lt;/b&gt;&lt;br&gt;src: aircraft_seat_layouts&lt;br&gt;DISTINCT code, model, range&lt;br&gt;key: aircraft_code&lt;br&gt;reject: conflicting attrs" vertex="1">
          <mxGeometry height="150" width="260" x="1050" y="150" as="geometry" />
        </mxCell>
        <mxCell id="s-seats" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;seats&lt;/b&gt;&lt;br&gt;src: aircraft_seat_layouts&lt;br&gt;WHERE seat_no IS NOT NULL&lt;br&gt;key: aircraft_code + seat_no&lt;br&gt;reject: invalid fare_conditions, conflicting attrs" vertex="1">
          <mxGeometry height="150" width="260" x="1330" y="150" as="geometry" />
        </mxCell>
        <mxCell id="s-bookings" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;bookings&lt;/b&gt;&lt;br&gt;src: flight_seat_reservations&lt;br&gt;WHERE book_ref IS NOT NULL&lt;br&gt;key: book_ref&lt;br&gt;reject: conflicting attrs (dup ref, diff book_date)" vertex="1">
          <mxGeometry height="150" width="260" x="1610" y="150" as="geometry" />
        </mxCell>
        <mxCell id="s-tickets" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;tickets&lt;/b&gt;&lt;br&gt;src: flight_seat_reservations&lt;br&gt;WHERE ticket_no IS NOT NULL&lt;br&gt;key: ticket_no&lt;br&gt;passenger_id → SHA-256 passenger_key&lt;br&gt;reject: conflicting attrs" vertex="1">
          <mxGeometry height="160" width="260" x="770" y="330" as="geometry" />
        </mxCell>
        <mxCell id="s-ticket-flights" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;ticket_flights&lt;/b&gt;&lt;br&gt;src: flight_seat_reservations&lt;br&gt;WHERE ticket_no IS NOT NULL&lt;br&gt;key: ticket_no + flight_id&lt;br&gt;reject: amount &amp;lt; 0, bad fare_conditions, unknown FK" vertex="1">
          <mxGeometry height="160" width="260" x="1050" y="330" as="geometry" />
        </mxCell>
        <mxCell id="s-boarding-passes" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;boarding_passes&lt;/b&gt;&lt;br&gt;src: flight_seat_reservations&lt;br&gt;WHERE ticket_no &amp; seat_no NOT NULL&lt;br&gt;key: ticket_no + flight_id&lt;br&gt;reject: missing boarding_no, seat not on aircraft" vertex="1">
          <mxGeometry height="160" width="260" x="1330" y="330" as="geometry" />
        </mxCell>
        <mxCell id="s-flights-enriched" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;flights_enriched&lt;/b&gt;&lt;br&gt;src: flight_seat_reservations (every row)&lt;br&gt;key: flight_id&lt;br&gt;reject: arrival &amp;lt;= departure, bad status, unknown airport/aircraft&lt;br&gt;+ haversine distance, local dep. tz, delay &amp; duration" vertex="1">
          <mxGeometry height="160" width="260" x="1610" y="330" as="geometry" />
        </mxCell>
        <mxCell id="quarantine" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;lake.silver.quarantine&lt;/b&gt;&lt;br&gt;source_table, reason, payload, _batch_id, _ingest_ts&lt;br&gt;&lt;i&gt;one row per rejected source row, per entity&#39;s rule above&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="400" x="1130" y="600" as="geometry" />
        </mxCell>
        <mxCell id="gold" parent="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Gold — marts &amp; dims&lt;/b&gt;&lt;br&gt;gold_route_revenue — sum(amount), count(ticket_no) by route+month+fare&lt;br&gt;gold_route_pareto — revenue rank + cumulative share (80/20)&lt;br&gt;gold_flight_occupancy — boarded/seats, Departed+Arrived only&lt;br&gt;gold_fleet — flight hours, avg duration, avg load factor, seat mix&lt;br&gt;gold_delay_heatmap — dow × hour, delay_rate (dep_delay_min &amp;gt; 15)&lt;br&gt;gold_delay_by_aircraft — delay rate &amp; avg delay, by model&lt;br&gt;gold_delay_by_route — same, by directional pair (count &amp;gt;= 20)&lt;br&gt;dim_airports — geo + departure counts&lt;br&gt;dim_routes — top 100 routes w/ coords" vertex="1">
          <mxGeometry height="300" width="340" x="2280" y="150" as="geometry" />
        </mxCell>
        <mxCell id="mongo" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;align=left;verticalAlign=top;spacingLeft=8;spacingTop=14;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;MongoDB — airlines db&lt;/b&gt;&lt;br&gt;(mirrors Gold mart names)&lt;br&gt;+ pipeline_runs&lt;br&gt;+ live_bookings (streaming)" vertex="1">
          <mxGeometry height="180" width="300" x="2300" y="670" as="geometry" />
        </mxCell>
        <mxCell id="e-raw-bronze" edge="1" parent="1" source="raw" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="bronze" value="JDBC extract · cast jsonb/point/array/interval → text · full snapshot append">
